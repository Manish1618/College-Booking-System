# Copy to .env and adjust. Never commit .env.
# The values below are for local development with `docker compose up`.

# --- Core ---
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:3000
SITE_NAME=College Guesthouse
SITE_URL=http://localhost:8080
# Public hostname Caddy serves. Use a real domain in production to get automatic TLS.
SITE_ADDRESS=:8080
# Reverse proxies in front of Django (Caddy = 1). Used to read the real client IP.
TRUSTED_PROXY_COUNT=1

# --- Database and Redis (compose service names) ---
POSTGRES_DB=guesthouse
POSTGRES_USER=guesthouse
POSTGRES_PASSWORD=guesthouse
DATABASE_URL=postgres://guesthouse:guesthouse@db:5432/guesthouse
REDIS_URL=redis://redis:6379/0

# --- Sign-in ---
# Emails on these domains are college members (the fallback while SSO is not connected).
COLLEGE_EMAIL_DOMAINS=college.example.edu
# Development only: show the sign-in code on screen instead of relying on email.
OTP_DEBUG_ECHO=true
# Managers and admins must use an authenticator app. Keep true outside local development.
STAFF_MFA_REQUIRED=true
# College SSO (OIDC). Fill in and set OIDC_ENABLED=true once the IT cell issues credentials.
OIDC_ENABLED=false
# OIDC_RP_CLIENT_ID=
# OIDC_RP_CLIENT_SECRET=
# OIDC_OP_AUTHORIZATION_ENDPOINT=
# OIDC_OP_TOKEN_ENDPOINT=
# OIDC_OP_USER_ENDPOINT=
# OIDC_OP_JWKS_ENDPOINT=
# Cloudflare Turnstile on the sign-in form. Set both keys together, or leave both empty to switch it off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Booking rules (confirm with the college; see README "Assumptions") ---
BOOKING_HOLD_HOURS=48
PAYMENT_WINDOW_HOURS=24
BOOKING_MAX_NIGHTS=14
BOOKING_MAX_ADVANCE_DAYS=180

# --- Payments ---
# Gateways offered to guests, in the order shown: razorpay, mobikwik, dev.
# "dev" simulates a gateway so the whole flow works without keys. The server refuses to start with it
# when DEBUG is false, unless ALLOW_SIMULATED_PAYMENTS=true (for a demo server only).
PAYMENT_GATEWAYS=dev
# Razorpay: API keys from the dashboard, and the secret typed when adding the webhook
#   https://<your-domain>/api/payments/webhooks/razorpay
# with the events payment.captured, payment.failed, order.paid, refund.processed and refund.failed.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# MobiKwik (its gateway is Zaakpay): merchant identifier and secret key from the Zaakpay dashboard.
# Set the dashboard's callback URL to https://<your-domain>/api/payments/webhooks/mobikwik
# MOBIKWIK_MERCHANT_ID=
# MOBIKWIK_SECRET_KEY=
# MOBIKWIK_BASE_URL=https://zaakstaging.zaakpay.com   # test server; the default is the live one
# MOBIKWIK_FALLBACK_EMAIL=guesthouse@college.example.edu

# --- Refund rules (confirm with the college; see README "Assumptions") ---
# Hours are counted back from CHECK_IN_HOUR on the arrival date.
REFUND_FULL_HOURS=48
REFUND_PARTIAL_HOURS=24
REFUND_PARTIAL_PERCENT=50
REFUND_NO_SHOW_PERCENT=0
CHECK_IN_HOUR=12

# --- Email and SMS ---
# Console backend prints emails to the worker log. Use the SMTP backend in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Guesthouse <guesthouse@college.example.edu>

# --- File storage ---
# false keeps files on local volumes (development). Production must use the private bucket.
S3_ENABLED=false
# S3_ENDPOINT_URL=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BUCKET=
# S3_PRIVATE_BUCKET=
